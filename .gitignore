/export_credentials.cfg

# Python asset-generation tools.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local environment variables / API keys.
.env
.env.*
!.env.example
!.env.sample

# macOS metadata.
.DS_Store
._*

# Keep source art, generated game assets, *.import, *.uid, and .gdignore files
